      } else if (tab === 'account') {
        secAccount.classList.remove("hidden");
        document.getElementById("desk-nav-account").className = "px-4 py-2 rounded-xl text-xs font-bold bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm transition flex items-center gap-2";
        document.getElementById("mob-nav-account").className = "flex flex-col items-center gap-1 text-emerald-600 dark:text-emerald-400 transition";
      }
    };

    // SERVICE FILTERING & RENDERING
    window.filterByPlatform = function(platform) {
      activePlatform = platform;
      document.querySelectorAll(".platform-chip").forEach(btn => {
        if (btn.dataset.platform === platform) {
          btn.className = "platform-chip px-3.5 py-2 rounded-xl text-xs font-bold bg-emerald-600 text-white transition whitespace-nowrap shadow-sm";
        } else {
          btn.className = "platform-chip px-3.5 py-2 rounded-xl text-xs font-bold bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-800 hover:text-slate-900 dark:hover:text-white transition whitespace-nowrap";
        }
      });
      window.renderServicesGrid();
    };

    window.filterServices = function() {
      window.renderServicesGrid();
    };

    window.renderServicesGrid = function() {
      const container = document.getElementById("services-grid");
      const searchQuery = (document.getElementById("service-search")?.value || "").toLowerCase();

      const keys = Object.keys(allServices).filter(k => {
        const item = allServices[k];
        const matchesPlatform = activePlatform === "ALL" || item.platform === activePlatform;
        const matchesSearch = item.title.toLowerCase().includes(searchQuery) || item.platform.toLowerCase().includes(searchQuery);
        return matchesPlatform && matchesSearch;
      });

      if (!keys.length) {
        container.innerHTML = `<div class="col-span-full py-16 text-center text-slate-400 text-xs">No services found matching your search.</div>`;
        return;
      }

      container.innerHTML = keys.map(k => {
        const item = allServices[k];
        return `
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-5 space-y-4 hover:border-emerald-500/50 hover:shadow-emerald-500/5 transition flex flex-col justify-between shadow-sm">
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider px-2.5 py-1 rounded-lg bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-100 dark:border-emerald-900/40">${item.platform}</span>
                <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium"><i class="fa-solid fa-bolt text-amber-400 mr-1"></i>${item.quantity || 'Fast Delivery'}</span>
              </div>
              <h3 class="font-bold text-sm text-slate-900 dark:text-white leading-snug">${item.title}</h3>
            </div>
            
            <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between">
              <div>
                <span class="text-[10px] text-slate-400 block font-medium">Instant Price</span>
                <span class="text-base font-black text-emerald-600 dark:text-emerald-400">₹${item.price}</span>
              </div>
              <button onclick="openCheckoutModal('${k}')" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-4 py-2 rounded-xl text-xs transition shadow-md shadow-emerald-600/20 flex items-center gap-1.5">
                <span>Buy Now</span>
                <i class="fa-solid fa-arrow-right text-[10px]"></i>
              </button>
            </div>
          </div>
        `;
      }).join('');
    };

    // CHECKOUT & CASHFREE GATEWAY
    window.openCheckoutModal = function(id) {
      const item = allServices[id];
      if (!item) return;

      document.getElementById("modal-service-id").value = id;
      document.getElementById("modal-service-platform").innerText = item.platform;
      document.getElementById("modal-service-title").innerText = item.title;
      document.getElementById("modal-service-speed").innerText = item.quantity || "Standard Delivery";
      document.getElementById("modal-service-price").innerText = `₹${item.price}`;
      
      if (currentUser && currentUser.phone) {
        document.getElementById("order-phone").value = currentUser.phone;
      }

      document.getElementById("checkout-modal").classList.remove("hidden");
    };

    window.closeCheckoutModal = function() {
      document.getElementById("checkout-modal").classList.add("hidden");
    };

    window.initiateCashfreePayment = function(e) {
      e.preventDefault();
      const svcId = document.getElementById("modal-service-id").value;
      const targetLink = document.getElementById("order-target-link").value;
      const phone = document.getElementById("order-phone").value;
      const svc = allServices[svcId];

      const orderKey = "ORD-" + Math.floor(100000 + Math.random() * 900000);
      const newOrder = {
        orderId: orderKey,
        userEmail: currentUser.email,
        userName: currentUser.name,
        serviceTitle: svc.title,
        platform: svc.platform,
        amount: svc.price,
        targetLink: targetLink,
        phone: phone,
        status: "PENDING",
        createdAt: Date.now()
      };

      // Push to Firebase Realtime DB
      const newRef = push(ref(db, "orders"));
      set(newRef, newOrder).then(() => {
        closeCheckoutModal();
        switchTab("orders");

        // Simulate Cashfree Drop Checkout
        alert(`Cashfree Gateway Initialized for Order ${orderKey} (₹${svc.price}). Use the Webhook Simulator in Account tab to mark as PAID.`);
      });
    };

    // ORDERS LISTING & ACCOUNT STATS
    window.renderUserOrders = function() {
      const tbody = document.getElementById("user-orders-body");
      if (!currentUser || !tbody) return;

      const userOrders = Object.values(allOrders)
        .filter(o => o.userEmail === currentUser.email)
        .sort((a,b) => b.createdAt - a.createdAt);

      if (!userOrders.length) {
        tbody.innerHTML = `<tr><td colspan="6" class="py-12 text-center text-slate-400">No orders placed yet.</td></tr>`;
        return;
      }

      tbody.innerHTML = userOrders.map(o => `
        <tr>
          <td class="py-3.5 px-4 font-mono text-slate-500 dark:text-slate-400 text-[11px] font-bold">${o.orderId}</td>
          <td class="py-3.5 px-4 font-medium text-slate-900 dark:text-white">${o.serviceTitle}</td>
          <td class="py-3.5 px-4 text-slate-500 dark:text-slate-400 truncate max-w-xs">${o.targetLink}</td>
          <td class="py-3.5 px-4 font-bold text-slate-900 dark:text-white">₹${o.amount}</td>
          <td class="py-3.5 px-4"><span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold ${o.status==='PAID'||o.status==='COMPLETED'?'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400':'bg-amber-500/10 text-amber-600 dark:text-amber-400'}">${o.status}</span></td>
          <td class="py-3.5 px-4 text-right text-slate-400">${new Date(o.createdAt).toLocaleDateString()}</td>
        </tr>
      `).join('');
    };

    window.refreshOrders = function() {
      window.renderUserOrders();
      window.updateAccountStats();
    };

    window.updateAccountStats = function() {
      if (!currentUser) return;
      const userOrders = Object.values(allOrders).filter(o => o.userEmail === currentUser.email);
      const totalSpent = userOrders.reduce((acc, o) => acc + (Number(o.amount) || 0), 0);

      const totalElem = document.getElementById("account-total-orders");
      const spentElem = document.getElementById("account-total-spent");

      if (totalElem) totalElem.innerText = userOrders.length;
      if (spentElem) spentElem.innerText = `₹${totalSpent}`;
    };

    // WEBHOOK SIMULATOR MODAL
    window.openWebhookModal = function() {
      const select = document.getElementById("webhook-order-select");
      if (!select) return;

      const pendingOrders = Object.entries(allOrders).filter(([k, v]) => v.userEmail === currentUser.email && v.status === "PENDING");

      if (!pendingOrders.length) {
        select.innerHTML = `<option value="">No pending orders available</option>`;
      } else {
        select.innerHTML = pendingOrders.map(([key, item]) => `
          <option value="${key}">${item.orderId} - ${item.serviceTitle} (₹${item.amount})</option>
        `).join('');
      }

      document.getElementById("webhook-modal").classList.remove("hidden");
    };

    window.closeWebhookModal = function() {
      document.getElementById("webhook-modal").classList.add("hidden");
    };

    window.dispatchWebhookEvent = function() {
      const select = document.getElementById("webhook-order-select");
      const key = select.value;

      if (!key) {
        alert("Please select a pending order to simulate payment.");
        return;
      }

      update(ref(db, `orders/${key}`), {
        status: "PAID",
        paidAt: Date.now()
      }).then(() => {
        alert("Cashfree Webhook simulation successful! Order marked as PAID.");
        closeWebhookModal();
        switchTab("orders");
      });
    };
  </script>

</body>
</html>
