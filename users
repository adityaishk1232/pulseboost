<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PulseBoost | Premium Social Growth Platform</title>
  
  <!-- Google Fonts & FontAwesome -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#f0fdf4',
              100: '#dcfce7',
              500: '#10b981',
              600: '#059669',
              700: '#047857',
            },
            accent: {
              500: '#8b5cf6',
              600: '#7c3aed',
              700: '#6d28d9',
            }
          }
        }
      }
    }
  </script>

  <!-- Cashfree JS SDK v3 -->
  <script src="https://sdk.cashfree.com/js/v3/cashfree.js"></script>

  <style>
    * { transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease; }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
    .dark ::-webkit-scrollbar-thumb { background: #334155; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; }
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
  </style>

  <script>
    // Theme Initializer to prevent light/dark flash
    (function() {
      const savedTheme = localStorage.getItem('pulseboost_theme') || 'dark';
      if (savedTheme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    })();
  </script>
</head>
<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 font-sans antialiased flex flex-col min-h-screen pb-20 md:pb-0">

  <!-- ================= AUTH VIEW (SIGN IN / SIGN UP) ================= -->
  <div id="view-auth" class="fixed inset-0 z-50 bg-slate-950 flex items-center justify-center p-4 overflow-y-auto">
    <div class="w-full max-w-md bg-slate-900/90 backdrop-blur-xl border border-slate-800/80 rounded-3xl p-8 shadow-2xl space-y-6">
      
      <!-- Brand Logo Header -->
      <div class="text-center space-y-2">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-emerald-500 via-teal-500 to-violet-600 text-white mx-auto flex items-center justify-center font-bold text-xl shadow-lg shadow-emerald-500/20">
          <i class="fa-solid fa-bolt"></i>
        </div>
        <h1 class="text-2xl font-black text-white tracking-tight">PulseBoost</h1>
        <p class="text-xs text-slate-400">Accelerate your social audience and reach</p>
      </div>

      <!-- Auth Switcher Tabs -->
      <div class="grid grid-cols-2 gap-1 bg-slate-950 p-1 rounded-2xl border border-slate-800/80">
        <button id="tab-login" onclick="switchAuthTab('login')" class="py-2.5 rounded-xl text-xs font-bold bg-gradient-to-r from-emerald-500 to-teal-600 text-white shadow-md transition">Sign In</button>
        <button id="tab-signup" onclick="switchAuthTab('signup')" class="py-2.5 rounded-xl text-xs font-bold text-slate-400 hover:text-white transition">Create Account</button>
      </div>

      <!-- Login Form -->
      <form id="form-login" onsubmit="handleLogin(event)" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Email Address</label>
          <input type="email" id="login-email" required placeholder="name@company.com" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-xs text-white focus:outline-none focus:border-emerald-500">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Password</label>
          <input type="password" id="login-password" required placeholder="••••••••" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-xs text-white focus:outline-none focus:border-emerald-500">
        </div>
        <button type="submit" class="w-full bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white font-bold py-3.5 rounded-xl text-xs transition shadow-lg shadow-emerald-500/20 flex items-center justify-center gap-2">
          <span>Sign In</span>
          <i class="fa-solid fa-arrow-right"></i>
        </button>
      </form>

      <!-- Signup Form -->
      <form id="form-signup" onsubmit="handleSignup(event)" class="space-y-4 hidden">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Full Name</label>
          <input type="text" id="signup-name" required placeholder="Alex Rivera" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-xs text-white focus:outline-none focus:border-indigo-500">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Email Address</label>
          <input type="email" id="signup-email" required placeholder="alex@domain.com" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-xs text-white focus:outline-none focus:border-indigo-500">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Mobile Phone Number</label>
          <input type="tel" id="signup-phone" required placeholder="9876543210" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-xs text-white focus:outline-none focus:border-indigo-500">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Password</label>
          <input type="password" id="signup-password" minlength="6" required placeholder="••••••••" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-xs text-white focus:outline-none focus:border-indigo-500">
        </div>
        <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-3.5 rounded-xl text-xs transition shadow-lg shadow-indigo-600/25 flex items-center justify-center gap-2">
          <span>Create Account</span>
          <i class="fa-solid fa-user-plus"></i>
        </button>
      </form>

      <!-- Quick Demo Login Button -->
      <div class="pt-2 border-t border-slate-800 text-center">
        <button onclick="handleDemoLogin()" type="button" class="text-xs text-slate-400 hover:text-indigo-400 font-medium transition flex items-center justify-center gap-1.5 mx-auto">
          <i class="fa-solid fa-wand-magic-sparkles text-indigo-400"></i>
          <span>Instant Demo Client Sign In</span>
        </button>
      </div>

    </div>
  </div>

  <!-- ================= MAIN STORE DASHBOARD ================= -->
  <div id="view-dashboard" class="hidden flex-col min-h-screen">

    <!-- TOP DESKTOP HEADER -->
    <header class="border-b border-slate-200 dark:border-slate-800/80 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md sticky top-0 z-40">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        
        <!-- Logo -->
        <div class="flex items-center space-x-3">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-emerald-500 to-teal-600 text-white flex items-center justify-center font-bold text-base shadow-md shadow-emerald-500/20">
            <i class="fa-solid fa-bolt"></i>
          </div>
          <div>
            <span class="font-extrabold text-base tracking-tight text-slate-900 dark:text-white block">PulseBoost</span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">Growth Storefront</span>
          </div>
        </div>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center space-x-1 bg-slate-100 dark:bg-slate-950 p-1 rounded-2xl border border-slate-200 dark:border-slate-800">
          <button onclick="switchTab('store')" id="desk-nav-store" class="px-4 py-2 rounded-xl text-xs font-bold bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm transition flex items-center gap-2">
            <i class="fa-solid fa-shop text-emerald-500"></i> Store
          </button>
          <button onclick="switchTab('orders')" id="desk-nav-orders" class="px-4 py-2 rounded-xl text-xs font-bold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition flex items-center gap-2">
            <i class="fa-solid fa-receipt"></i> Orders
          </button>
          <button onclick="switchTab('account')" id="desk-nav-account" class="px-4 py-2 rounded-xl text-xs font-bold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition flex items-center gap-2">
            <i class="fa-solid fa-user"></i> Account
          </button>
        </nav>

        <!-- Theme Toggle & Profile Info -->
        <div class="flex items-center space-x-3">
          
          <!-- Theme Switcher Button -->
          <button onclick="toggleTheme()" id="btn-theme-toggle" title="Toggle Light/Dark Theme" class="w-9 h-9 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 flex items-center justify-center hover:border-slate-300 dark:hover:border-slate-700 transition">
            <i id="theme-icon" class="fa-solid fa-moon"></i>
          </button>

          <!-- User Display Badge -->
          <div class="hidden sm:flex items-center space-x-2 pl-2 border-l border-slate-200 dark:border-slate-800">
            <div class="w-8 h-8 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 font-bold flex items-center justify-center text-xs border border-emerald-500/20">
              <span id="user-avatar-initial">U</span>
            </div>
            <div class="text-left leading-tight">
              <span id="user-display-name" class="block text-xs font-bold text-slate-900 dark:text-white">User</span>
              <span id="user-display-email" class="block text-[10px] text-slate-500 dark:text-slate-400">user@domain.com</span>
            </div>
          </div>

        </div>

      </div>
    </header>

    <!-- MAIN BODY CONTENT -->
    <main class="flex-grow max-w-6xl w-full mx-auto px-4 py-6 space-y-6">

      <!-- ================= SECTION 1: SERVICE STORE ================= -->
      <section id="section-store" class="space-y-6">
        
        <!-- Hero Banner -->
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-slate-950 to-emerald-950 p-6 md:p-8 text-white border border-slate-800/80 shadow-2xl">
          <div class="relative z-10 max-w-xl space-y-3">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-400/30 text-emerald-400 text-[11px] font-semibold">
              <i class="fa-solid fa-shield-check text-emerald-400"></i> 100% Safe & Instant Delivery Guaranteed
            </div>
            <h2 class="text-2xl md:text-3xl font-black tracking-tight leading-tight bg-gradient-to-r from-white via-slate-100 to-emerald-300 bg-clip-text text-transparent">Elevate Your Social Presence Instantly</h2>
            <p class="text-slate-300 text-xs md:text-sm leading-relaxed">Supercharge your reach, engagement, and authority across all major social networks with premium, high-retention growth solutions.</p>
          </div>
          <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>
          <div class="absolute right-32 -top-10 w-48 h-48 bg-violet-600/15 rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <!-- Search & Category Filters -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          
          <!-- Search Bar -->
          <div class="relative flex-grow max-w-md">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3.5 text-slate-400 text-xs"></i>
            <input type="text" id="service-search" oninput="filterServices()" placeholder="Search growth services..." class="w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl pl-10 pr-4 py-2.5 text-xs text-slate-900 dark:text-white focus:outline-none focus:border-emerald-500 shadow-sm">
          </div>

          <!-- Platform Filter Chips -->
          <div class="flex items-center gap-2 overflow-x-auto pb-1 md:pb-0" id="platform-chips">
            <button onclick="filterByPlatform('ALL')" class="platform-chip px-3.5 py-2 rounded-xl text-xs font-bold bg-emerald-600 text-white transition whitespace-nowrap shadow-sm" data-platform="ALL">All Platforms</button>
            <button onclick="filterByPlatform('YouTube')" class="platform-chip px-3.5 py-2 rounded-xl text-xs font-bold bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-800 hover:text-slate-900 dark:hover:text-white transition whitespace-nowrap" data-platform="YouTube"><i class="fa-brands fa-youtube text-red-500 mr-1.5"></i>YouTube</button>
            <button onclick="filterByPlatform('Instagram')" class="platform-chip px-3.5 py-2 rounded-xl text-xs font-bold bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-800 hover:text-slate-900 dark:hover:text-white transition whitespace-nowrap" data-platform="Instagram"><i class="fa-brands fa-instagram text-pink-500 mr-1.5"></i>Instagram</button>
            <button onclick="filterByPlatform('Twitter/X')" class="platform-chip px-3.5 py-2 rounded-xl text-xs font-bold bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-800 hover:text-slate-900 dark:hover:text-white transition whitespace-nowrap" data-platform="Twitter/X"><i class="fa-brands fa-x-twitter text-slate-800 dark:text-slate-200 mr-1.5"></i>Twitter/X</button>
            <button onclick="filterByPlatform('Telegram')" class="platform-chip px-3.5 py-2 rounded-xl text-xs font-bold bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-800 hover:text-slate-900 dark:hover:text-white transition whitespace-nowrap" data-platform="Telegram"><i class="fa-brands fa-telegram text-sky-400 mr-1.5"></i>Telegram</button>
          </div>

        </div>

        <!-- Services Grid -->
        <div id="services-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <div class="col-span-full py-16 text-center text-slate-400 text-xs">Loading available growth services...</div>
        </div>

      </section>

      <!-- ================= SECTION 2: MY ORDERS ================= -->
      <section id="section-orders" class="space-y-6 hidden">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-lg font-bold text-slate-900 dark:text-white">Order History & Live Tracking</h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">Track delivery status for your active campaigns</p>
          </div>
          <button onclick="refreshOrders()" class="text-xs bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 px-3 py-1.5 rounded-xl font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition">
            <i class="fa-solid fa-rotate mr-1"></i> Refresh
          </button>
        </div>

        <!-- Orders Table Card -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl overflow-hidden shadow-sm">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-slate-50 dark:bg-slate-950/70 border-b border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 uppercase text-[10px] font-bold">
                <tr>
                  <th class="py-3.5 px-4">Order ID</th>
                  <th class="py-3.5 px-4">Service</th>
                  <th class="py-3.5 px-4">Target Link</th>
                  <th class="py-3.5 px-4">Amount</th>
                  <th class="py-3.5 px-4">Payment Status</th>
                  <th class="py-3.5 px-4 text-right">Date</th>
                </tr>
              </thead>
              <tbody id="user-orders-body" class="divide-y divide-slate-100 dark:divide-slate-800/60">
                <tr><td colspan="6" class="py-12 text-center text-slate-400">No orders found.</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ================= SECTION 3: ACCOUNT & SETTINGS ================= -->
      <section id="section-account" class="space-y-6 hidden">
        
        <div>
          <h2 class="text-lg font-bold text-slate-900 dark:text-white">Account Settings & Security</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400">Manage your credentials, password security, and system preferences</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          
          <!-- User Profile Overview Card -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 space-y-6 shadow-sm md:col-span-2">
            
            <div class="flex items-center space-x-4 border-b border-slate-100 dark:border-slate-800 pb-5">
              <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-emerald-500 to-teal-600 text-white font-black text-2xl flex items-center justify-center shadow-lg shadow-emerald-500/20">
                <span id="account-avatar-large">U</span>
              </div>
              <div>
                <h3 id="account-name" class="font-extrabold text-base text-slate-900 dark:text-white">User Name</h3>
                <p id="account-email" class="text-xs text-slate-500 dark:text-slate-400">user@example.com</p>
                <div class="flex items-center gap-2 mt-2">
                  <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[10px] font-bold border border-emerald-500/20">Active Account</span>
                  <span class="px-2.5 py-0.5 rounded-full bg-violet-500/10 text-violet-600 dark:text-violet-400 text-[10px] font-bold border border-violet-500/20"><i class="fa-solid fa-shield-check mr-1"></i>Secure Session</span>
                </div>
              </div>
            </div>

            <!-- Stats Overview -->
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-slate-50 dark:bg-slate-950 p-4 rounded-2xl border border-slate-200 dark:border-slate-800">
                <span class="text-[10px] font-bold uppercase text-slate-400">Total Orders Placed</span>
                <span id="account-total-orders" class="block text-xl font-extrabold text-slate-900 dark:text-white mt-1">0</span>
              </div>
              <div class="bg-slate-50 dark:bg-slate-950 p-4 rounded-2xl border border-slate-200 dark:border-slate-800">
                <span class="text-[10px] font-bold uppercase text-slate-400">Total Spent</span>
                <span id="account-total-spent" class="block text-xl font-extrabold text-emerald-600 dark:text-emerald-400 mt-1">₹0</span>
              </div>
            </div>

            <!-- Security & Password Card -->
            <div class="bg-slate-50 dark:bg-slate-950/60 p-5 rounded-2xl border border-slate-200 dark:border-slate-800/80 space-y-3">
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-3">
                  <div class="w-10 h-10 rounded-xl bg-violet-500/10 text-violet-600 dark:text-violet-400 flex items-center justify-center font-bold">
                    <i class="fa-solid fa-key text-base"></i>
                  </div>
                  <div>
                    <h4 class="text-xs font-bold text-slate-900 dark:text-white">Security & Password</h4>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400">Update your account password regularly</p>
                  </div>
                </div>
                <button onclick="openChangePasswordModal()" class="px-3.5 py-2 rounded-xl text-xs font-bold bg-violet-600 hover:bg-violet-500 text-white transition shadow-sm flex items-center gap-1.5">
                  <i class="fa-solid fa-lock-keyhole"></i>
                  <span>Change Password</span>
                </button>
              </div>
              <div id="password-status-badge" class="text-[11px] text-slate-500 dark:text-slate-400 flex items-center gap-1.5 pt-1">
                <i class="fa-solid fa-circle-info text-emerald-500"></i>
                <span>Password last changed: <strong id="lbl-last-password-change" class="text-slate-700 dark:text-slate-300 font-semibold">Protected Session</strong></span>
              </div>
            </div>

            <!-- Developer Tools Launcher -->
            <div class="pt-2 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between">
              <div>
                <h4 class="text-xs font-bold text-slate-900 dark:text-white">Developer Webhook Agent Simulator</h4>
                <p class="text-[11px] text-slate-500 dark:text-slate-400">Test Cashfree payment verification callbacks</p>
              </div>
              <button onclick="openWebhookModal()" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-700 transition">
                <i class="fa-solid fa-code text-emerald-500 mr-1.5"></i> Open Simulator
              </button>
            </div>

          </div>

          <!-- Preferences & Actions Card -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 space-y-6 shadow-sm flex flex-col justify-between">
            <div class="space-y-4">
              <h3 class="font-bold text-sm text-slate-900 dark:text-white">Preferences</h3>
              
              <!-- Mode Selection -->
              <div class="space-y-2">
                <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400">Appearance Theme</label>
                <div class="grid grid-cols-2 gap-2 bg-slate-100 dark:bg-slate-950 p-1 rounded-2xl border border-slate-200 dark:border-slate-800">
                  <button onclick="setThemeMode('light')" id="theme-btn-light" class="py-2 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5">
                    <i class="fa-solid fa-sun text-amber-500"></i> Light
                  </button>
                  <button onclick="setThemeMode('dark')" id="theme-btn-dark" class="py-2 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5">
                    <i class="fa-solid fa-moon text-violet-400"></i> Dark
                  </button>
                </div>
              </div>
            </div>

            <!-- Logout Button -->
            <button onclick="handleLogout()" class="w-full bg-rose-500/10 hover:bg-rose-500/20 text-rose-600 dark:text-rose-400 font-bold py-3 rounded-2xl text-xs transition border border-rose-500/20 flex items-center justify-center gap-2">
              <i class="fa-solid fa-power-off"></i> Sign Out
            </button>
          </div>

        </div>

      </section>

    </main>

    <!-- MOBILE BOTTOM NAVIGATION FOOTER -->
    <nav class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/90 dark:bg-slate-900/90 backdrop-blur-lg border-t border-slate-200 dark:border-slate-800 px-6 py-2">
      <div class="flex items-center justify-around">
        <button onclick="switchTab('store')" id="mob-nav-store" class="flex flex-col items-center gap-1 text-emerald-600 dark:text-emerald-400 transition">
          <i class="fa-solid fa-shop text-base"></i>
