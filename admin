    // WORKING THEME SWITCHER
    window.setTheme = function(mode) {
      localStorage.setItem("pulseboost_theme", mode);

      const darkBtn = document.getElementById('theme-btn-dark');
      const lightBtn = document.getElementById('theme-btn-light');

      if (mode === 'light') {
        document.documentElement.classList.remove('dark');
        if (lightBtn) lightBtn.className = "px-2.5 py-1 rounded-full text-zinc-950 bg-white font-bold shadow-sm";
        if (darkBtn) darkBtn.className = "px-2.5 py-1 rounded-full text-zinc-400 hover:text-zinc-200";
      } else {
        document.documentElement.classList.add('dark');
        if (darkBtn) darkBtn.className = "px-2.5 py-1 rounded-full text-zinc-100 bg-zinc-800 font-bold shadow-sm";
        if (lightBtn) lightBtn.className = "px-2.5 py-1 rounded-full text-zinc-400 hover:text-zinc-200";
      }

      // Re-render chart to adjust tick colors
      initCharts();
    };
  </script>

