<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PulseBoost | Admin Command Center</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Chart.js for Income Analytics -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- Google Font: Plus Jakarta Sans -->
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Plus Jakarta Sans', 'system-ui', 'sans-serif'] }
        }
      }
    }
  </script>
  
  <style>
    * { transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease; }
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #27272a; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #3f3f46; }

    /* Light Theme Styling Overrides */
    html:not(.dark) body {
      background-color: #f8fafc !important;
      color: #0f172a !important;
    }
    html:not(.dark) .bg-zinc-950 { background-color: #f1f5f9 !important; }
    html:not(.dark) .bg-zinc-900, 
    html:not(.dark) .bg-zinc-900\/90,
    html:not(.dark) .bg-zinc-900\/80 { background-color: #ffffff !important; color: #0f172a !important; border-color: #e2e8f0 !important; }
    html:not(.dark) .border-zinc-800, 
    html:not(.dark) .border-zinc-800\/80, 
    html:not(.dark) .border-zinc-800\/60 { border-color: #e2e8f0 !important; }
    html:not(.dark) .text-white { color: #0f172a !important; }
    html:not(.dark) .text-zinc-400, html:not(.dark) .text-zinc-500 { color: #64748b !important; }
    html:not(.dark) .text-zinc-300 { color: #334155 !important; }
    html:not(.dark) input, html:not(.dark) select {
      background-color: #f8fafc !important;
      color: #0f172a !important;
      border-color: #cbd5e1 !important;
    }
    html:not(.dark) .bg-zinc-800 { background-color: #e2e8f0 !important; color: #1e293b !important; }
    html:not(.dark) .hover\:bg-zinc-800:hover { background-color: #cbd5e1 !important; }
  </style>
</head>
<body class="bg-zinc-950 text-zinc-100 font-sans antialiased min-h-screen flex flex-col selection:bg-zinc-800 selection:text-white pb-16 md:pb-0">

  <!-- ================= TOAST NOTIFICATION CONTAINER ================= -->
  <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none"></div>

  <!-- ================= ADMIN AUTH LOGIN PAGE ================= -->
  <div id="view-admin-login" class="fixed inset-0 z-50 bg-zinc-950 flex items-center justify-center p-4">
    <div class="w-full max-w-sm bg-zinc-900 border border-zinc-800 rounded-3xl p-8 shadow-2xl space-y-6 relative overflow-hidden">
      <!-- Glow effect -->
      <div class="absolute -top-12 -right-12 w-32 h-32 bg-emerald-500/10 rounded-full blur-2xl pointer-events-none"></div>

      <div class="text-center space-y-2">
        <div class="w-12 h-12 rounded-2xl bg-white text-zinc-950 mx-auto flex items-center justify-center font-extrabold text-xl shadow-lg">
          <i class="fa-solid fa-shield-halved"></i>
        </div>
        <h1 class="text-xl font-extrabold text-white tracking-tight">Admin Portal</h1>
        <p class="text-xs text-zinc-400">PulseBoost Executive Operations & Income Center</p>
      </div>

      <form onsubmit="handleAdminLogin(event)" class="space-y-4">
        <div>
          <label class="block text-[11px] font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Admin Security Key / Email</label>
          <input type="text" id="admin-user-input" required value="admin@pulseboost.io" placeholder="admin@pulseboost.io" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-zinc-500">
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Password</label>
          <input type="password" id="admin-pass-input" required value="admin1234" placeholder="••••••••" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-zinc-500">
        </div>

        <button type="submit" class="w-full bg-emerald-500 hover:bg-emerald-600 text-zinc-950 font-bold py-3 rounded-xl text-xs transition shadow-lg flex items-center justify-center gap-2">
          <span>Authenticate Admin</span>
          <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </button>
      </form>

      <div class="pt-2 border-t border-zinc-800/80 text-center">
        <button onclick="quickDemoLogin()" class="text-xs text-emerald-400 hover:text-emerald-300 font-semibold transition flex items-center justify-center gap-1.5 mx-auto">
          <i class="fa-solid fa-bolt-lightning text-[10px]"></i>
          <span>Instant One-Click Demo Access</span>
        </button>
      </div>
    </div>
  </div>

  <!-- ================= ADMIN DASHBOARD LAYOUT ================= -->
  <div id="view-admin-app" class="hidden min-h-screen flex-col">

    <!-- TOP HEADER -->
    <header class="border-b border-zinc-800/80 bg-zinc-900/80 backdrop-blur-md sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
        
        <!-- Brand & Badges -->
        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 rounded-xl bg-emerald-500 text-zinc-950 flex items-center justify-center font-black text-sm shadow-md">
            <i class="fa-solid fa-shield-halved"></i>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="font-extrabold text-sm tracking-tight text-white">PulseBoost</span>
              <span class="text-[9px] font-extrabold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-1.5 py-0.5 rounded tracking-wide">ADMIN</span>
            </div>
            <p class="text-[10px] text-zinc-400 hidden sm:block">Management & Revenue Control Center</p>
          </div>
        </div>

        <!-- Right Controls -->
        <div class="flex items-center space-x-3">
          <!-- Working Theme Switcher -->
          <div class="bg-zinc-950 border border-zinc-800 rounded-full p-1 flex items-center gap-1 text-xs shadow-inner">
            <button onclick="setTheme('dark')" id="theme-btn-dark" class="px-2.5 py-1 rounded-full text-zinc-100 bg-zinc-800 font-medium"><i class="fa-solid fa-moon"></i></button>
            <button onclick="setTheme('light')" id="theme-btn-light" class="px-2.5 py-1 rounded-full text-zinc-400 hover:text-zinc-200"><i class="fa-solid fa-sun"></i></button>
          </div>

          <!-- Live Database Status Indicator -->
          <div class="hidden md:flex items-center gap-1.5 bg-zinc-950 border border-zinc-800 px-3 py-1.5 rounded-xl text-[11px] text-zinc-400">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Realtime DB Active</span>
          </div>

          <!-- Settings & Logout -->
          <div class="flex items-center gap-2 border-l border-zinc-800 pl-3">
            <button onclick="switchAdminTab('settings')" title="Admin Credentials & Security" class="p-2 text-zinc-400 hover:text-emerald-400 transition text-xs">
              <i class="fa-solid fa-user-gear text-sm"></i>
            </button>
            <button onclick="handleAdminLogout()" title="Logout Admin" class="p-2 text-zinc-400 hover:text-red-400 transition text-xs">
              <i class="fa-solid fa-power-off text-sm"></i>
            </button>
          </div>
        </div>

      </div>
    </header>

    <!-- MAIN BODY CONTAINER -->
    <div class="max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 flex-grow space-y-6">

      <!-- DESKTOP TOP NAV TABS -->
      <div class="hidden md:flex items-center justify-between border-b border-zinc-800 pb-4 overflow-x-auto gap-2">
        <div class="flex space-x-2 min-w-max">
          <button onclick="switchAdminTab('income')" id="tab-btn-income" class="px-4 py-2 rounded-xl text-xs font-bold bg-emerald-500 text-zinc-950 transition flex items-center gap-2 shadow-sm">
            <i class="fa-solid fa-chart-line"></i> Income & Financials
          </button>
          <button onclick="switchAdminTab('orders')" id="tab-btn-orders" class="px-4 py-2 rounded-xl text-xs font-bold bg-zinc-900 text-zinc-400 hover:text-white border border-zinc-800 transition flex items-center gap-2">
            <i class="fa-solid fa-boxes-stack"></i> Order Fulfillment <span id="pending-orders-badge" class="bg-amber-500/20 text-amber-400 text-[10px] px-1.5 py-0.2 rounded-full hidden">0</span>
          </button>
          <button onclick="switchAdminTab('services')" id="tab-btn-services" class="px-4 py-2 rounded-xl text-xs font-bold bg-zinc-900 text-zinc-400 hover:text-white border border-zinc-800 transition flex items-center gap-2">
            <i class="fa-solid fa-layer-group"></i> Service Catalog
          </button>
          <button onclick="switchAdminTab('users')" id="tab-btn-users" class="px-4 py-2 rounded-xl text-xs font-bold bg-zinc-900 text-zinc-400 hover:text-white border border-zinc-800 transition flex items-center gap-2">
            <i class="fa-solid fa-users"></i> Users Database
          </button>
          <button onclick="switchAdminTab('settings')" id="tab-btn-settings" class="px-4 py-2 rounded-xl text-xs font-bold bg-zinc-900 text-zinc-400 hover:text-white border border-zinc-800 transition flex items-center gap-2">
            <i class="fa-solid fa-key"></i> Admin Security
          </button>
        </div>

        <button onclick="seedDatabaseIfEmpty()" class="flex items-center gap-1.5 text-[11px] text-zinc-400 hover:text-emerald-400 bg-zinc-900 border border-zinc-800 px-3 py-1.5 rounded-xl transition">
          <i class="fa-solid fa-database"></i> Reset Demo Data
        </button>
      </div>

      <!-- ================= TAB 1: INCOME & FINANCIALS ================= -->
      <section id="section-income" class="space-y-6">
        
        <!-- Metric Cards Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          
          <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl p-4 space-y-2 relative overflow-hidden shadow-sm">
            <div class="flex items-center justify-between text-zinc-400 text-xs font-semibold">
              <span>Gross Income</span>
              <i class="fa-solid fa-indian-rupee-sign text-emerald-400"></i>
            </div>
            <div id="stat-gross-income" class="text-2xl font-black text-white">₹0.00</div>
            <p class="text-[10px] text-emerald-400 flex items-center gap-1">
              <i class="fa-solid fa-arrow-trend-up"></i> Cashfree Verified Direct Earnings
            </p>
          </div>

          <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl p-4 space-y-2 shadow-sm">
            <div class="flex items-center justify-between text-zinc-400 text-xs font-semibold">
              <span>Est. Net Profit (45%)</span>
              <i class="fa-solid fa-piggy-bank text-blue-400"></i>
            </div>
            <div id="stat-net-profit" class="text-2xl font-black text-emerald-400">₹0.00</div>
            <p class="text-[10px] text-zinc-500">Calculated after API provider costs</p>
          </div>

          <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl p-4 space-y-2 shadow-sm">
            <div class="flex items-center justify-between text-zinc-400 text-xs font-semibold">
              <span>Paid Transactions</span>
              <i class="fa-solid fa-receipt text-amber-400"></i>
            </div>
            <div id="stat-paid-count" class="text-2xl font-black text-white">0</div>
            <p class="text-[10px] text-zinc-400" id="stat-avg-ticket">Avg. Ticket: ₹0</p>
          </div>

          <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl p-4 space-y-2 shadow-sm">
            <div class="flex items-center justify-between text-zinc-400 text-xs font-semibold">
              <span>Payment Success Rate</span>
              <i class="fa-solid fa-circle-check text-purple-400"></i>
            </div>
            <div id="stat-success-rate" class="text-2xl font-black text-white">100%</div>
            <p class="text-[10px] text-purple-400">Cashfree PG Gateway Sync</p>
          </div>

        </div>

        <!-- Income Analytics & Platform Share -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          
          <!-- Chart -->
          <div class="lg:col-span-2 bg-zinc-900/90 border border-zinc-800 rounded-2xl p-5 space-y-4">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-sm font-bold text-white">Income Trend & Revenue Flow</h3>
                <p class="text-[11px] text-zinc-400">Recent customer growth purchases</p>
              </div>
              <span class="text-[10px] bg-zinc-950 border border-zinc-800 px-2.5 py-1 rounded-lg text-zinc-400">Realtime Feed</span>
            </div>
            <div class="h-60 w-full relative">
              <canvas id="incomeChart"></canvas>
            </div>
          </div>

          <!-- Platform Breakdown -->
          <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl p-5 space-y-4 flex flex-col justify-between">
            <div>
              <h3 class="text-sm font-bold text-white mb-1">Platform Revenue Share</h3>
              <p class="text-[11px] text-zinc-400 mb-4">Earnings distribution across services</p>
              <div class="h-44 relative flex items-center justify-center">
                <canvas id="platformChart"></canvas>
              </div>
            </div>
            <div id="platform-legend" class="grid grid-cols-2 gap-2 text-[11px] pt-3 border-t border-zinc-800">
              <!-- Rendered via JS -->
            </div>
          </div>

        </div>

        <!-- Cashfree Income Transaction Log -->
        <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl overflow-hidden space-y-3 p-5">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <h3 class="text-sm font-bold text-white">Cashfree Income Logs</h3>
              <p class="text-[11px] text-zinc-400">Detailed record of client payments received</p>
            </div>
            <div class="relative w-full sm:w-64">
              <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-zinc-500 text-xs"></i>
              <input type="text" id="income-search" oninput="renderIncomeTable()" placeholder="Search Txn ID, email..." class="w-full bg-zinc-950 border border-zinc-800 rounded-xl pl-9 pr-3 py-1.5 text-xs text-white focus:outline-none focus:border-zinc-500">
            </div>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-zinc-950/80 text-zinc-400 uppercase text-[10px] border-b border-zinc-800">
                <tr>
                  <th class="py-3 px-4">Txn / Order ID</th>
                  <th class="py-3 px-4">Client Email</th>
                  <th class="py-3 px-4">Purchased Package</th>
                  <th class="py-3 px-4">Gateway</th>
                  <th class="py-3 px-4">Amount</th>
                  <th class="py-3 px-4 text-right">Date & Time</th>
                </tr>
              </thead>
              <tbody id="income-table-body" class="divide-y divide-zinc-800/60">
                <tr><td colspan="6" class="py-8 text-center text-zinc-500">Loading income logs...</td></tr>
              </tbody>
            </table>
          </div>
        </div>

      </section>

      <!-- ================= TAB 2: ORDER FULFILLMENT ================= -->
      <section id="section-orders" class="space-y-4 hidden">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-zinc-900/90 border border-zinc-800 p-4 rounded-2xl">
          <div>
            <h2 class="text-sm font-bold text-white">Order Processing & Fulfillment Hub</h2>
            <p class="text-[11px] text-zinc-400">Update campaign statuses to sync directly with user dashboards</p>
          </div>
          <div class="flex items-center gap-2">
            <select id="order-status-filter" onchange="renderOrdersTable()" class="bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-1.5 text-xs text-white focus:outline-none">
              <option value="ALL">All Statuses</option>
              <option value="PENDING">Pending</option>
              <option value="IN_PROGRESS">In Progress</option>
              <option value="COMPLETED">Completed</option>
              <option value="REFUNDED">Refunded</option>
            </select>
          </div>
        </div>

        <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-zinc-950/80 text-zinc-400 uppercase text-[10px] border-b border-zinc-800">
                <tr>
                  <th class="py-3 px-4">Order ID</th>
                  <th class="py-3 px-4">Client / Target Link</th>
                  <th class="py-3 px-4">Service</th>
                  <th class="py-3 px-4">Price</th>
                  <th class="py-3 px-4">Status Action</th>
                  <th class="py-3 px-4 text-right">Date</th>
                </tr>
              </thead>
              <tbody id="admin-orders-body" class="divide-y divide-zinc-800/60">
                <tr><td colspan="6" class="py-8 text-center text-zinc-500">Loading orders...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ================= TAB 3: SERVICE CATALOG MANAGEMENT ================= -->
      <section id="section-services" class="space-y-4 hidden">
        <div class="flex items-center justify-between bg-zinc-900/90 border border-zinc-800 p-4 rounded-2xl">
          <div>
            <h2 class="text-sm font-bold text-white">Service Catalog Manager</h2>
            <p class="text-[11px] text-zinc-400">Add, adjust prices, or disable growth packages</p>
          </div>
          <button onclick="openAddServiceModal()" class="bg-emerald-500 hover:bg-emerald-600 text-zinc-950 font-bold px-3.5 py-2 rounded-xl text-xs transition flex items-center gap-1.5 shadow-md">
            <i class="fa-solid fa-plus"></i> Add New Package
          </button>
        </div>

        <!-- Services Grid -->
        <div id="admin-services-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <div class="col-span-full py-12 text-center text-zinc-500 text-xs">Loading services...</div>
        </div>
      </section>

      <!-- ================= TAB 4: USERS DATABASE ================= -->
      <section id="section-users" class="space-y-4 hidden">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-zinc-900/90 border border-zinc-800 p-4 rounded-2xl">
          <div>
            <h2 class="text-sm font-bold text-white">Registered Client Accounts</h2>
            <p class="text-[11px] text-zinc-400">Monitor client activity, spend, and manage access</p>
          </div>
          <div class="relative w-full sm:w-64">
            <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-zinc-500 text-xs"></i>
            <input type="text" id="user-search" oninput="renderUsersTable()" placeholder="Search by name, email..." class="w-full bg-zinc-950 border border-zinc-800 rounded-xl pl-9 pr-3 py-1.5 text-xs text-white focus:outline-none focus:border-zinc-500">
          </div>
        </div>

        <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-zinc-950/80 text-zinc-400 uppercase text-[10px] border-b border-zinc-800">
                <tr>
                  <th class="py-3 px-4">User Email</th>
                  <th class="py-3 px-4">Contact Phone</th>
                  <th class="py-3 px-4">Total Orders</th>
                  <th class="py-3 px-4">Lifetime Spent</th>
                  <th class="py-3 px-4">Account Status</th>
                  <th class="py-3 px-4 text-right">Actions</th>
                </tr>
              </thead>
              <tbody id="users-table-body" class="divide-y divide-zinc-800/60">
                <tr><td colspan="6" class="py-8 text-center text-zinc-500">Loading user records...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ================= TAB 5: ADMIN SECURITY & CREDENTIALS ================= -->
      <section id="section-settings" class="space-y-4 hidden">
        <div class="bg-zinc-900/90 border border-zinc-800 p-6 rounded-2xl max-w-xl mx-auto space-y-6">
          <div class="flex items-center gap-3 border-b border-zinc-800 pb-4">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold">
              <i class="fa-solid fa-key text-lg"></i>
            </div>
            <div>
              <h2 class="text-sm font-bold text-white">Admin Credentials & Security</h2>
              <p class="text-[11px] text-zinc-400">Update your login email/username and password stored in Firebase</p>
            </div>
          </div>

          <form onsubmit="handleAdminCredentialsUpdate(event)" class="space-y-4">
            <div>
              <label class="block text-[11px] font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">New Admin Username / Email</label>
              <input type="text" id="setting-admin-user" required placeholder="admin@pulseboost.io" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-zinc-500">
            </div>

            <div>
              <label class="block text-[11px] font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">New Password</label>
              <input type="password" id="setting-admin-pass" required placeholder="••••••••" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-zinc-500">
            </div>

            <div>
              <label class="block text-[11px] font-semibold text-zinc-400 uppercase tracking-wider mb-1.5">Confirm New Password</label>
              <input type="password" id="setting-admin-pass-confirm" required placeholder="••••••••" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-zinc-500">
            </div>

            <button type="submit" class="w-full bg-emerald-500 hover:bg-emerald-600 text-zinc-950 font-bold py-3 rounded-xl text-xs transition shadow-md flex items-center justify-center gap-2">
              <i class="fa-solid fa-floppy-disk"></i>
              <span>Save Admin Credentials to Firebase</span>
            </button>
          </form>
        </div>
      </section>

    </div>

    <!-- MOBILE BOTTOM NAVIGATION BAR -->
    <nav class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-zinc-900/95 border-t border-zinc-800 backdrop-blur-lg flex justify-around items-center p-2 text-[10px]">
      <button onclick="switchAdminTab('income')" id="mob-tab-income" class="flex flex-col items-center gap-1 text-emerald-400 py-1 px-2 rounded-lg">
