  <!-- FIREBASE & ADMIN CORE LOGIC -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
    import { getDatabase, ref, onValue, set, push, remove, update, get } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-database.js";

    const firebaseConfig = {
      apiKey: "AIzaSyDQFYdl9SRgylZEdLNIUbAg4LtB7E6_Uo4",
      authDomain: "school-88506.firebaseapp.com",
      databaseURL: "https://school-88506-default-rtdb.firebaseio.com",
      projectId: "school-88506",
      storageBucket: "school-88506.firebasestorage.app",
      messagingSenderId: "220132241066",
      appId: "1:220132241066:web:8862c6f824fdc933d4ead3"
    };

    const app = initializeApp(firebaseConfig);
    const db = getDatabase(app);

    let allServices = {};
    let allOrders = {};
    let adminCredentials = { user: "admin@pulseboost.io", pass: "admin1234" };

    let incomeChartInstance = null;
    let platformChartInstance = null;

    // Toast Notification System
    window.showToast = function(message, type = 'success') {
      const container = document.getElementById("toast-container");
      const toast = document.createElement("div");
      toast.className = `p-3 rounded-xl text-xs font-semibold shadow-xl border backdrop-blur-md flex items-center justify-between pointer-events-auto transition-all duration-300 transform translate-y-2 opacity-0 ${
        type === 'success' 
          ? 'bg-emerald-950/90 text-emerald-200 border-emerald-500/30' 
          : 'bg-red-950/90 text-red-200 border-red-500/30'
      }`;
      toast.innerHTML = `
        <div class="flex items-center gap-2">
          <i class="fa-solid ${type === 'success' ? 'fa-circle-check text-emerald-400' : 'fa-circle-exclamation text-red-400'}"></i>
          <span>${message}</span>
        </div>
      `;
      container.appendChild(toast);

      setTimeout(() => {
        toast.classList.remove("translate-y-2", "opacity-0");
      }, 10);

      setTimeout(() => {
        toast.classList.add("opacity-0");
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    };

    // Modal Confirmation Helper
    window.showConfirmModal = function(title, desc, onConfirm) {
      const modal = document.getElementById("modal-confirm");
      document.getElementById("confirm-modal-title").innerText = title;
      document.getElementById("confirm-modal-desc").innerText = desc;
      
      const confirmBtn = document.getElementById("confirm-action-btn");
      const cancelBtn = document.getElementById("confirm-cancel-btn");

      const handleConfirm = () => {
        onConfirm();
        closeConfirmModal();
      };

      const closeConfirmModal = () => {
        modal.classList.add("hidden");
        confirmBtn.removeEventListener("click", handleConfirm);
      };

      confirmBtn.onclick = handleConfirm;
      cancelBtn.onclick = closeConfirmModal;
      modal.classList.remove("hidden");
    };

    // Check Admin Session State
    window.addEventListener("DOMContentLoaded", () => {
      // Load stored theme or default dark
      const currentTheme = localStorage.getItem("pulseboost_theme") || "dark";
      window.setTheme(currentTheme);

      const isAdmin = sessionStorage.getItem("pulseboost_admin_authenticated");
      if (isAdmin === "true") {
        showAdminApp();
      } else {
        showAdminLogin();
      }
    });

    // Firebase Data Listeners
    function attachDatabaseListeners() {
      // Admin Security Credentials Listener
      onValue(ref(db, "admin_settings/credentials"), (snapshot) => {
        if (snapshot.exists()) {
          adminCredentials = snapshot.val();
        }
        document.getElementById("setting-admin-user").value = adminCredentials.user || "admin@pulseboost.io";
      });

      // Services Catalog Listener
      onValue(ref(db, "paid_services"), (snapshot) => {
        allServices = snapshot.val() || {};
        window.renderAdminServices();
        updateFinancials();
      });

      // Orders Listener
      onValue(ref(db, "orders"), (snapshot) => {
        allOrders = snapshot.val() || {};
        window.renderOrdersTable();
        window.renderIncomeTable();
        window.renderUsersTable();
        updateFinancials();
      });
    }

    // AUTH FUNCTIONS
    window.handleAdminLogin = async function(e) {
      if (e) e.preventDefault();
      const userIn = document.getElementById("admin-user-input").value;
      const passIn = document.getElementById("admin-pass-input").value;

      try {
        const snap = await get(ref(db, "admin_settings/credentials"));
        if (snap.exists()) {
          adminCredentials = snap.val();
        }
      } catch (err) {
        console.error("Firebase read error fallback to local", err);
      }

      if (userIn === adminCredentials.user && passIn === adminCredentials.pass) {
        sessionStorage.setItem("pulseboost_admin_authenticated", "true");
        showAdminApp();
        showToast("Admin Authenticated Successfully!", "success");
      } else {
        showToast("Invalid Admin Username or Password!", "error");
      }
    };

    window.quickDemoLogin = function() {
      sessionStorage.setItem("pulseboost_admin_authenticated", "true");
      showAdminApp();
      showToast("Demo Access Granted", "success");
    };

    window.handleAdminLogout = function() {
      sessionStorage.removeItem("pulseboost_admin_authenticated");
      showAdminLogin();
      showToast("Admin Logged Out", "success");
    };

    function showAdminApp() {
      document.getElementById("view-admin-login").classList.add("hidden");
      document.getElementById("view-admin-app").classList.remove("hidden");
      document.getElementById("view-admin-app").classList.add("flex");
      attachDatabaseListeners();
    }

    function showAdminLogin() {
      document.getElementById("view-admin-app").classList.add("hidden");
      document.getElementById("view-admin-app").classList.remove("flex");
      document.getElementById("view-admin-login").classList.remove("hidden");
    }

    // TAB SWITCHER (Supports Mobile & Desktop)
    window.switchAdminTab = function(tab) {
      const tabs = ['income', 'orders', 'services', 'users', 'settings'];
      tabs.forEach(t => {
        const sec = document.getElementById(`section-${t}`);
        const btn = document.getElementById(`tab-btn-${t}`);
        const mobBtn = document.getElementById(`mob-tab-${t}`);

        if (t === tab) {
          sec?.classList.remove("hidden");
          if (btn) btn.className = "px-4 py-2 rounded-xl text-xs font-bold bg-emerald-500 text-zinc-950 transition flex items-center gap-2 shadow-sm";
          if (mobBtn) mobBtn.className = "flex flex-col items-center gap-1 text-emerald-400 py-1 px-2 rounded-lg font-bold";
        } else {
          sec?.classList.add("hidden");
          if (btn) btn.className = "px-4 py-2 rounded-xl text-xs font-bold bg-zinc-900 text-zinc-400 hover:text-white border border-zinc-800 transition flex items-center gap-2";
          if (mobBtn) mobBtn.className = "flex flex-col items-center gap-1 text-zinc-400 py-1 px-2 rounded-lg";
        }
      });

      if (tab === 'income') {
        setTimeout(initCharts, 50);
      }
    };

    // UPDATE ADMIN CREDENTIALS IN FIREBASE
    window.handleAdminCredentialsUpdate = function(e) {
      e.preventDefault();
      const newUser = document.getElementById("setting-admin-user").value.trim();
      const newPass = document.getElementById("setting-admin-pass").value;
      const confirmPass = document.getElementById("setting-admin-pass-confirm").value;

      if (!newUser) {
        showToast("Please enter a valid admin email/username", "error");
        return;
      }

      if (newPass !== confirmPass) {
        showToast("Passwords do not match!", "error");
        return;
      }

      if (newPass.length < 6) {
        showToast("Password should be at least 6 characters long", "error");
        return;
      }

      const updatedCreds = { user: newUser, pass: newPass };
      set(ref(db, "admin_settings/credentials"), updatedCreds)
        .then(() => {
          adminCredentials = updatedCreds;
          document.getElementById("setting-admin-pass").value = "";
          document.getElementById("setting-admin-pass-confirm").value = "";
          showToast("Admin credentials updated in Firebase!", "success");
        })
        .catch(err => {
          showToast("Failed to update credentials: " + err.message, "error");
        });
    };

    // FINANCIAL CALCULATIONS & CHARTS
    function updateFinancials() {
      const orderList = Object.values(allOrders);
      
      let grossIncome = 0;
      let paidCount = 0;
      const platformMap = {};

      orderList.forEach(o => {
        const amt = parseFloat(o.amount) || 0;
        grossIncome += amt;
        paidCount++;

        const p = o.platform || 'General';
        platformMap[p] = (platformMap[p] || 0) + amt;
      });

      const netProfit = grossIncome * 0.45; // 45% estimated margin
      const avgTicket = paidCount > 0 ? (grossIncome / paidCount).toFixed(0) : 0;

      const grossEl = document.getElementById("stat-gross-income");
      const profitEl = document.getElementById("stat-net-profit");
      const paidEl = document.getElementById("stat-paid-count");
      const avgEl = document.getElementById("stat-avg-ticket");

      if (grossEl) grossEl.innerText = `₹${grossIncome.toLocaleString('en-IN', {minimumFractionDigits: 2})}`;
      if (profitEl) profitEl.innerText = `₹${netProfit.toLocaleString('en-IN', {minimumFractionDigits: 2})}`;
      if (paidEl) paidEl.innerText = paidCount;
      if (avgEl) avgEl.innerText = `Avg Ticket: ₹${avgTicket}`;

      // Update pending badge
      const pendingCount = orderList.filter(o => o.status === 'PENDING').length;
      const badge = document.getElementById("pending-orders-badge");
      if (badge) {
        if (pendingCount > 0) {
          badge.innerText = pendingCount;
          badge.classList.remove("hidden");
        } else {
          badge.classList.add("hidden");
        }
      }

      initCharts(platformMap);
    }

    function initCharts(platformMap = {}) {
      const isDark = document.documentElement.classList.contains("dark");
      const textColor = isDark ? '#a1a1aa' : '#475569';
      const gridColor = isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)';

      // Income Trend Line Chart
      const ctx1 = document.getElementById("incomeChart")?.getContext("2d");
      if (ctx1) {
        if (incomeChartInstance) incomeChartInstance.destroy();

        const dates = ['Oct 1', 'Oct 2', 'Oct 3', 'Oct 4', 'Today'];
        const grossVal = parseFloat(document.getElementById("stat-gross-income")?.innerText.replace(/[^0-9.]/g, '')) || 8500;
        const dataVals = [2400, 4800, 3100, 6200, grossVal];

        incomeChartInstance = new Chart(ctx1, {
          type: 'line',
          data: {
            labels: dates,
            datasets: [{
              label: 'Revenue (₹)',
              data: dataVals,
              borderColor: '#10b981',
              backgroundColor: 'rgba(16, 185, 129, 0.08)',
              fill: true,
              tension: 0.35,
              borderWidth: 2,
              pointRadius: 4,
              pointBackgroundColor: '#10b981'
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
              x: { grid: { color: gridColor }, ticks: { color: textColor, font: { size: 10 } } },
              y: { grid: { color: gridColor }, ticks: { color: textColor, font: { size: 10 } } }
            }
          }
        });
      }

      // Platform Pie/Doughnut Chart
      const ctx2 = document.getElementById("platformChart")?.getContext("2d");
      if (ctx2) {
        if (platformChartInstance) platformChartInstance.destroy();

        const labels = Object.keys(platformMap).length ? Object.keys(platformMap) : ['YouTube', 'Instagram', 'Twitter/X', 'Telegram'];
        const values = Object.values(platformMap).length ? Object.values(platformMap) : [4500, 3200, 1500, 1800];
        const colors = ['#ef4444', '#ec4899', '#38bdf8', '#22c55e', '#a855f7'];

        platformChartInstance = new Chart(ctx2, {
          type: 'doughnut',
          data: {
            labels: labels,
            datasets: [{
              data: values,
              backgroundColor: colors.slice(0, labels.length),
              borderWidth: 0
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            cutout: '70%'
          }
        });

        // Legend
        const legendContainer = document.getElementById("platform-legend");
        if (legendContainer) {
          legendContainer.innerHTML = labels.map((l, idx) => `
            <div class="flex items-center gap-1.5 text-zinc-400">
              <span class="w-2.5 h-2.5 rounded-full" style="background-color: ${colors[idx % colors.length]}"></span>
              <span class="truncate">${l}: <strong class="text-white">₹${values[idx]}</strong></span>
            </div>
          `).join('');
        }
      }
    }

    // RENDER TABLES & CATALOG
    window.renderIncomeTable = function() {
      const tbody = document.getElementById("income-table-body");
      if (!tbody) return;
      const search = (document.getElementById("income-search")?.value || "").toLowerCase();
      
      const orders = Object.values(allOrders).filter(o => 
        (o.orderId && o.orderId.toLowerCase().includes(search)) ||
        (o.userEmail && o.userEmail.toLowerCase().includes(search)) ||
        (o.serviceTitle && o.serviceTitle.toLowerCase().includes(search))
      ).reverse();

      if (!orders.length) {
        tbody.innerHTML = `<tr><td colspan="6" class="py-8 text-center text-zinc-500">No income records found.</td></tr>`;
        return;
      }

      tbody.innerHTML = orders.map(o => `
        <tr class="hover:bg-zinc-900/50 transition">
          <td class="py-3 px-4 font-mono text-zinc-300 text-[11px]">
            <span class="block font-bold text-white">${o.orderId || 'ORD-UNKNOWN'}</span>
            <span class="text-[9px] text-zinc-500">CF_TXN_${Math.floor(1000000 + Math.random()*9000000)}</span>
          </td>
          <td class="py-3 px-4 text-zinc-300">${o.userEmail || 'Guest'}</td>
          <td class="py-3 px-4 text-white font-medium">
            <span class="text-[10px] text-zinc-500 block uppercase font-bold">${o.platform || 'SMM'}</span>
            ${o.serviceTitle || 'Growth Package'}
          </td>
          <td class="py-3 px-4"><span class="px-2 py-0.5 rounded text-[9px] font-extrabold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">CASHFREE UPI</span></td>
          <td class="py-3 px-4 font-black text-emerald-400">₹${o.amount}</td>
          <td class="py-3 px-4 text-right text-zinc-500">${new Date(o.createdAt || Date.now()).toLocaleString()}</td>
        </tr>
      `).join('');
    };

    window.renderOrdersTable = function() {
      const tbody = document.getElementById("admin-orders-body");
      if (!tbody) return;
      const filterStatus = document.getElementById("order-status-filter")?.value || "ALL";

      const entries = Object.entries(allOrders).filter(([key, o]) => {
        return filterStatus === "ALL" || o.status === filterStatus;
      }).reverse();

      if (!entries.length) {
        tbody.innerHTML = `<tr><td colspan="6" class="py-8 text-center text-zinc-500">No matching orders found.</td></tr>`;
        return;
      }

      tbody.innerHTML = entries.map(([dbKey, o]) => `
        <tr class="hover:bg-zinc-900/50 transition">
          <td class="py-3 px-4 font-mono text-zinc-300 text-[11px] font-bold">${o.orderId || dbKey}</td>
          <td class="py-3 px-4 text-zinc-300">
            <span class="block font-medium text-white">${o.userEmail || 'Client'}</span>
            <a href="${o.targetLink}" target="_blank" class="text-emerald-400 text-[10px] hover:underline truncate block max-w-xs"><i class="fa-solid fa-link mr-1"></i>${o.targetLink || 'Link'}</a>
          </td>
          <td class="py-3 px-4 text-white">${o.serviceTitle || 'Growth Pack'}</td>
          <td class="py-3 px-4 font-bold text-white">₹${o.amount}</td>
          <td class="py-3 px-4">
            <select onchange="updateOrderStatus('${dbKey}', this.value)" class="bg-zinc-950 border border-zinc-800 rounded-lg px-2 py-1 text-[11px] font-bold ${
              o.status === 'COMPLETED' ? 'text-emerald-400' : o.status === 'IN_PROGRESS' ? 'text-blue-400' : o.status === 'REFUNDED' ? 'text-red-400' : 'text-amber-400'
            }">
              <option value="PENDING" ${o.status==='PENDING'?'selected':''}>PENDING</option>
              <option value="IN_PROGRESS" ${o.status==='IN_PROGRESS'?'selected':''}>IN_PROGRESS</option>
              <option value="COMPLETED" ${o.status==='COMPLETED'?'selected':''}>COMPLETED</option>
              <option value="REFUNDED" ${o.status==='REFUNDED'?'selected':''}>REFUNDED</option>
            </select>
          </td>
          <td class="py-3 px-4 text-right text-zinc-500">${new Date(o.createdAt || Date.now()).toLocaleDateString()}</td>
        </tr>
      `).join('');
    };

    window.updateOrderStatus = function(dbKey, newStatus) {
      update(ref(db, `orders/${dbKey}`), { status: newStatus }).then(() => {
        showToast("Order Status Updated!", "success");
      });
    };

    window.renderAdminServices = function() {
      const grid = document.getElementById("admin-services-grid");
      if (!grid) return;
      const keys = Object.keys(allServices);

      if (!keys.length) {
        grid.innerHTML = `<div class="col-span-full py-12 text-center text-zinc-500 text-xs">No services found in database. Click "Reset Demo Data" to generate default items.</div>`;
        return;
      }

      grid.innerHTML = keys.map(k => {
        const item = allServices[k];
        const isActive = item.active !== false;

        return `
          <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl p-4 space-y-3 flex flex-col justify-between shadow-sm">
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-zinc-950 border border-zinc-800 text-zinc-400">${item.platform}</span>
                <button onclick="toggleServiceActive('${k}', ${!isActive})" class="text-[10px] font-extrabold px-2 py-0.5 rounded cursor-pointer transition ${isActive ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-red-500/10 text-red-400 border border-red-500/20'}">
                  ${isActive ? '● ACTIVE' : '○ DISABLED'}
                </button>
              </div>
              <h4 class="font-bold text-xs text-white">${item.title}</h4>
              <p class="text-[10px] text-zinc-500"><i class="fa-solid fa-bolt text-amber-400 mr-1"></i>Speed: ${item.quantity || 'Instant'}</p>
            </div>

            <div class="pt-3 border-t border-zinc-800 flex items-center justify-between">
              <div>
                <span class="text-[10px] text-zinc-500 block">Sale Price</span>
                <span class="text-sm font-black text-emerald-400">₹${item.price}</span>
              </div>
              <div class="flex gap-1.5">
                <button onclick="editService('${k}')" class="p-2 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-200 text-xs transition" title="Edit Service"><i class="fa-solid fa-pen-to-square"></i></button>
                <button onclick="deleteService('${k}')" class="p-2 rounded-xl bg-red-500/10 hover:bg-red-500/20 text-red-400 text-xs transition" title="Delete Service"><i class="fa-solid fa-trash"></i></button>
              </div>
            </div>
          </div>
        `;
      }).join('');
    };

    window.toggleServiceActive = function(id, nextState) {
      update(ref(db, `paid_services/${id}`), { active: nextState })
        .then(() => showToast(`Service ${nextState ? 'Activated' : 'Disabled'}`, "success"));
    };

    // USER MANAGEMENT & DELETION
    window.renderUsersTable = function() {
      const tbody = document.getElementById("users-table-body");
      if (!tbody) return;
      const search = (document.getElementById("user-search")?.value || "").toLowerCase();

      // Aggregate users from orders
      const userMap = {};
      Object.entries(allOrders).forEach(([ordKey, o]) => {
        const email = o.userEmail || 'anonymous@pulseboost.io';
        if (!userMap[email]) {
          userMap[email] = {
            email: email,
            phone: o.phone || 'N/A',
            ordersCount: 0,
            spent: 0,
            orderKeys: []
          };
        }
        userMap[email].ordersCount++;
        userMap[email].spent += parseFloat(o.amount) || 0;
        userMap[email].orderKeys.push(ordKey);
      });

      const users = Object.values(userMap).filter(u => u.email.toLowerCase().includes(search));

      if (!users.length) {
        tbody.innerHTML = `<tr><td colspan="6" class="py-8 text-center text-zinc-500">No users found in database.</td></tr>`;
        return;
      }

      tbody.innerHTML = users.map(u => `
        <tr class="hover:bg-zinc-900/50 transition">
          <td class="py-3 px-4">
            <div class="flex items-center gap-2">
              <div class="w-7 h-7 rounded-full bg-zinc-800 text-white flex items-center justify-center font-bold text-xs border border-zinc-700">
                ${u.email.charAt(0).toUpperCase()}
              </div>
              <span class="font-medium text-white">${u.email}</span>
            </div>
          </td>
          <td class="py-3 px-4 text-zinc-400">${u.phone}</td>
          <td class="py-3 px-4 font-bold text-white">${u.ordersCount}</td>
          <td class="py-3 px-4 font-black text-emerald-400">₹${u.spent.toLocaleString('en-IN')}</td>
          <td class="py-3 px-4"><span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">VERIFIED</span></td>
          <td class="py-3 px-4 text-right">
            <button onclick="deleteUserAccount('${u.email}')" class="text-xs text-red-400 hover:text-white bg-red-500/10 hover:bg-red-500 px-2.5 py-1 rounded-lg transition flex items-center gap-1 ml-auto">
              <i class="fa-solid fa-trash-can"></i>
              <span>Delete</span>
            </button>
          </td>
        </tr>
      `).join('');
    };

    window.deleteUserAccount = function(userEmail) {
      showConfirmModal(
        "Delete User Record",
        `Are you sure you want to remove ${userEmail} and wipe all associated order records from Firebase?`,
        () => {
          // Remove all orders associated with userEmail
          const updates = {};
          Object.entries(allOrders).forEach(([key, o]) => {
            if (o.userEmail === userEmail) {
              updates[`orders/${key}`] = null;
            }
          });

          update(ref(db), updates)
            .then(() => {
              showToast(`Deleted user ${userEmail} and cleared records.`, "success");
            })
            .catch(err => {
              showToast("Failed to delete user: " + err.message, "error");
            });
        }
      );
    };

    // SERVICE MODAL & ACTIONS
    window.openAddServiceModal = function() {
      document.getElementById("modal-service-title").innerText = "Add Growth Package";
      document.getElementById("form-svc-id").value = "";
      document.getElementById("form-svc-platform").value = "YouTube";
      document.getElementById("form-svc-title").value = "";
      document.getElementById("form-svc-price").value = "";
      document.getElementById("form-svc-quantity").value = "";
      document.getElementById("form-svc-active").value = "true";
      document.getElementById("modal-service").classList.remove("hidden");
    };

    window.editService = function(id) {
      const item = allServices[id];
      if (!item) return;

      document.getElementById("modal-service-title").innerText = "Edit Package";
      document.getElementById("form-svc-id").value = id;
      document.getElementById("form-svc-platform").value = item.platform || "YouTube";
      document.getElementById("form-svc-title").value = item.title || "";
      document.getElementById("form-svc-price").value = item.price || "";
      document.getElementById("form-svc-quantity").value = item.quantity || "";
      document.getElementById("form-svc-active").value = item.active !== false ? "true" : "false";

      document.getElementById("modal-service").classList.remove("hidden");
    };

    window.closeServiceModal = function() {
      document.getElementById("modal-service").classList.add("hidden");
    };

    window.saveServiceForm = function(e) {
      e.preventDefault();
      const id = document.getElementById("form-svc-id").value;
      const platform = document.getElementById("form-svc-platform").value;
      const title = document.getElementById("form-svc-title").value;
      const price = parseFloat(document.getElementById("form-svc-price").value);
      const quantity = document.getElementById("form-svc-quantity").value;
      const active = document.getElementById("form-svc-active").value === "true";

      const payload = { platform, title, price, quantity, active };

      if (id) {
        update(ref(db, `paid_services/${id}`), payload).then(() => {
          closeServiceModal();
          showToast("Service Package Updated!", "success");
        });
      } else {
        set(push(ref(db, "paid_services")), payload).then(() => {
          closeServiceModal();
          showToast("New Service Package Created!", "success");
        });
      }
    };

    window.deleteService = function(id) {
      showConfirmModal(
        "Delete Package",
        "Are you sure you want to permanently delete this growth service package?",
        () => {
          remove(ref(db, `paid_services/${id}`)).then(() => {
            showToast("Service Package Deleted", "success");
          });
        }
      );
    };

